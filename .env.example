# Dafeiyu local mode: no upstream cloud project or account is required.
APP_URL=dafeiyu://app
ENABLE_PALSHUB_INTEGRATION=false
ENABLE_AUTHENTICATION=false
ENABLE_OFFLINE_MODE=true

# Optional independent integrations. Leave unset until real configuration exists.
SUPABASE_URL=
SUPABASE_ANON_KEY=
PALSHUB_API_BASE_URL=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
